# Anchor CLI image: the pinned release binary, not a source build.
#
# The version, its sha256 and the upstream repo are mirrored in
# .github/anchor.env; scripts/bump-anchor.sh --check (CI) fails if they drift
# apart. The weekly anchor-bump workflow moves both when a release at least
# 7 days old is available; Dependabot (docker ecosystem, /images/anchor-cli)
# bumps the base image digest.
#
# `anchor idl fetch <program> --provider.cluster mainnet` needs only the
# anchor binary and CA certificates; the Solana CLI is not required. This holds
# for the 0.32 line only: from 1.0 it shells out to npx (see anchor.env).
FROM debian:trixie-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ARG ANCHOR_VERSION=0.32.2
ARG ANCHOR_SHA256=b3cdc15f3db924c2b11a7c16ceff21ad3da239ddde4e53f33df18e52e0461645
ARG ANCHOR_REPO=otter-sec/anchor

# BuildKit verifies the checksum before the layer is committed; --chmod makes
# the fetched binary executable without a second layer. The release binaries
# are built against a recent glibc; trixie (glibc 2.41) satisfies them.
ADD --checksum=sha256:${ANCHOR_SHA256} --chmod=0755 \
    https://github.com/${ANCHOR_REPO}/releases/download/v${ANCHOR_VERSION}/anchor-${ANCHOR_VERSION}-x86_64-unknown-linux-gnu \
    /usr/local/bin/anchor

RUN useradd --system --create-home --shell /usr/sbin/nologin anchor
USER anchor
ENTRYPOINT ["anchor"]
