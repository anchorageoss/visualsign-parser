FROM stagex/pallet-rust:1.94.0@sha256:2fbe7b164dd92edb9c1096152f6d27592d8a69b1b8eb2fc907b5fadea7d11668 AS build

# Rust configuration
ENV RUSTFLAGS='-C target-feature=+crt-static'
ENV CARGOFLAGS='--target x86_64-unknown-linux-musl --no-default-features --locked --release'

# Directory for Rust artifacts
ENV RELEASE_DIR=/src/parser/nsm-probe/target/x86_64-unknown-linux-musl/release

# Load Rust sources
ADD src /src
WORKDIR /src/

# nsm_probe is a standalone crate (own Cargo.lock, QOS 0.12.1), not a
# workspace member: pre-fetch its deps so the build can run `--network=none`.
WORKDIR /src/parser/nsm-probe
RUN cargo fetch
RUN --network=none <<-EOF
    set -eu
    cargo build ${CARGOFLAGS} --features vsock
    mkdir -p /rootfs
    mv ${RELEASE_DIR}/nsm_probe /rootfs/
EOF

# Use busybox as a base so we can easily cp the pivot binary if needed
FROM stagex/core-busybox:1.36.1@sha256:cac5d773db1c69b832d022c469ccf5f52daf223b91166e6866d42d6983a3b374 AS package
COPY --from=build /rootfs/. .
