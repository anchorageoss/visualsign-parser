# The Anchor release the anchor-cli image installs, and the sha256 GitHub
# records as the asset digest. The same values are the ARG defaults in
# images/anchor-cli/Containerfile; scripts/bump-anchor.sh --check (CI) fails
# if they drift apart.
# Bump with: scripts/bump-anchor.sh (run weekly by .github/workflows/anchor-bump.yml,
# which also builds and smoke-tests the image before opening the PR).
#
# ANCHOR_SERIES keeps bumps on the 0.32 line. From 1.0, `anchor idl fetch`
# no longer reads the IDL account itself: it runs
# `npx --yes @solana-program/program-metadata`, an unpinned npm download at
# run time that this image deliberately does not provide. Move the series
# only once that path can be pinned too.
ANCHOR_SERIES=0.32
ANCHOR_VERSION=0.32.2
ANCHOR_SHA256=b3cdc15f3db924c2b11a7c16ceff21ad3da239ddde4e53f33df18e52e0461645
ANCHOR_REPO=otter-sec/anchor
