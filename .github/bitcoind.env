# Bitcoin Core release the test:bitcoin-regtest lane runs, and its sha256.
# Read by scripts/install-bitcoind.sh. The hash is the
# bitcoin-<version>-x86_64-linux-gnu.tar.gz line of the release's SHA256SUMS,
# whose SHA256SUMS.asc was checked against the guix.sigs builder keys
# (11 good signatures for 31.1).
BITCOIND_VERSION=31.1
BITCOIND_SHA256_x86_64-linux-gnu=b80d9c3e04da78fb6f0569685673418cf686fadba9042d926d13fb87ff503f9e
